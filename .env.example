# ===========================================
# POLYMARKET TRADING BOT CONFIGURATION
# ===========================================

# Environment
ENVIRONMENT=development
DEBUG=true
PAPER_TRADING=true

# Polymarket Credentials
# IMPORTANT: NEVER commit your real private key to git!
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_wallet_address_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/polymarket_bot

# News APIs (optional, but recommended)
# Sign up at respective platforms to get API keys
CRYPTONEWS_API_KEY=your_cryptonews_api_key
COINFEEDS_API_KEY=your_coinfeeds_api_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Notifications (optional)
# Create a Telegram bot via @BotFather to get these
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Trading Configuration (can override defaults)
# MIN_CONFIDENCE=0.80
# MAX_POSITION_PCT=0.05
# PROFIT_LOCK_THRESHOLD=0.92
