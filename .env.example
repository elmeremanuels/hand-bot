# Polymarket Bot Configuration
# Copy this file to .env and fill in your actual credentials

# ==================== POLYMARKET API ====================
# Get your API credentials from https://polymarket.com
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# ==================== TRADING MODE ====================
# IMPORTANT: Start with paper trading to test!
# true = Paper trading (simulated, no real money)
# false = Live trading (real money - BE CAREFUL!)
PAPER_TRADING=true

# ==================== SAFETY LIMITS ====================
# Maximum position size per trade (USD)
# SAFETY: Default $5 max per trade to limit risk
MAX_POSITION_SIZE=5.0

# Maximum number of open positions at once
MAX_OPEN_POSITIONS=3

# Maximum total exposure across all positions (USD)
# Should be: MAX_POSITION_SIZE * MAX_OPEN_POSITIONS
MAX_TOTAL_EXPOSURE=15.0

# ==================== STRATEGY PARAMETERS ====================
# Target cryptocurrency (bitcoin, ethereum, solana, xrp, or leave empty for all)
TARGET_ASSET=bitcoin

# Confidence range for entry (0.0 to 1.0)
# SAFETY: Only trade when market probability is 80-95%
# Below 80%: too risky
# Above 95%: fees eat the profit margin
MIN_CONFIDENCE=0.80
MAX_CONFIDENCE=0.95

# Minimum expected profit edge (0.0 to 1.0)
MIN_EXPECTED_EDGE=0.10

# Time window for entry (seconds)
# MIN: Don't enter if less than 60s remaining
# MAX: Don't enter if more than 180s remaining (3 minutes)
MIN_TIME_REMAINING=60
MAX_TIME_REMAINING=180

# ==================== BOT SETTINGS ====================
# How often to scan for new markets (seconds)
SCAN_INTERVAL_SECONDS=10

# Enable debug logging
DEBUG=false

# Environment (development, staging, production)
ENVIRONMENT=development
